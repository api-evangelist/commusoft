      "name": "Authentication",
      "description": {
        "content": "Obtain API access tokens",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "38528cc6-13cd-4151-80e4-e37680d24c76",
          "name": "Get API Token",
          "request": {
            "name": "Get API Token",
            "description": {
              "content": "Obtain an API access token. You will need to request an API key from Commusoft before you can use the API. Provide your clientId, username, password, and applicationId to receive a token for subsequent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "getToken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"<string>\",\n  \"username\": \"<string>\",\n  \"password\": \"<password>\",\n  \"applicationId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "92a46a28-457f-446f-aee4-83ae65a37112",
              "name": "API token returned as plain text",
              "originalRequest": {
                "url": {
                  "path": [
                    "getToken"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "X-Auth-Token",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "text/plain"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clientId\": \"your-client-id\",\n  \"username\": \"user@example.com\",\n  \"password\": \"your-password\",\n  \"applicationId\": \"your-application-id\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "abc123token",
