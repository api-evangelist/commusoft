{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commusoft Authentication Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.commusoft.com/api/v1/users/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "Unique identifier (UUID) of the record"
              }
            ]
          },
          "docs": "Retrieve a specific user record by UUID."
        }
      ]
    }
  ],
  "bundled": true
}