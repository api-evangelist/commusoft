{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commusoft Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.commusoft.com/api/v1/getToken",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Obtain an API access token. You will need to request an API key from Commusoft before you can use the API. Provide your clientId, username, password, and applicationId to receive a token for subsequent requests."
        }
      ]
    }
  ],
  "bundled": true
}