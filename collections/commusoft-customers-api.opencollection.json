{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commusoft Authentication Customers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.commusoft.com/api/v1/customers",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "query",
                "description": "Filter by UUID"
              }
            ]
          },
          "docs": "Retrieve a list of customers from the Commusoft system."
        },
        {
          "info": {
            "name": "Create Customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.commusoft.com/api/v1/customers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new customer record to the Commusoft system."
        },
        {
          "info": {
            "name": "Get Customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.commusoft.com/api/v1/customers/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "Unique identifier (UUID) of the record"
              }
            ]
          },
          "docs": "Retrieve a specific customer record by UUID."
        },
        {
          "info": {
            "name": "Update Customer",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.commusoft.com/api/v1/customers/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "Unique identifier (UUID) of the record"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edit an existing customer record identified by UUID."
        },
        {
          "info": {
            "name": "Delete Customer",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.commusoft.com/api/v1/customers/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "Unique identifier (UUID) of the record"
              }
            ]
          },
          "docs": "Soft-delete a customer record. Commusoft never permanently deletes a customer; instead the record's Deleted field is set to 1."
        }
      ]
    }
  ],
  "bundled": true
}